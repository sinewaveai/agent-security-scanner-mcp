{
  "name": "agent-security-scanner-mcp",
  "version": "4.5.8",
  "mcpName": "io.github.sinewaveai/agent-security-scanner-mcp",
  "description": "AI agent security scanner and npm audit for MCP servers, Claude Code, Cursor, and Windsurf. Find prompt injection, hallucinated packages, secrets, unsafe tools, and vulnerable code.",
  "main": "index.js",
  "type": "module",
  "bin": {
    "agent-security-scanner-mcp": "index.js",
    "cr-agent": "code-review-agent/dist/bin/cr-agent.js"
  },
  "scripts": {
    "start": "node index.js",
    "actor:start": "node src/main.js",
    "postinstall": "node scripts/postinstall.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "benchmark": "python3 benchmarks/benchmark_runner.py --save --compare-latest"
  },
